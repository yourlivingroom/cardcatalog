{
    "name": "@livingroom/cardcatalog",
    "version": "0.0.1",
    "description": "Persistent, incrementally-maintained LevelDB indexes over a watched directory",
    "keywords": [
        "index",
        "indexer",
        "leveldb",
        "level",
        "chokidar",
        "watch",
        "directory",
        "materialized-view"
    ],
    "homepage": "https://github.com/yourlivingroom/cardcatalog#readme",
    "bugs": "https://github.com/yourlivingroom/cardcatalog/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yourlivingroom/cardcatalog.git"
    },
    "license": "ISC",
    "author": "Hampton Smith <1743291+hamptonsmith@users.noreply.github.com>",
    "type": "module",
    "exports": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
    },
    "main": "index.mjs",
    "types": "./index.d.mts",
    "files": [
        "index.mjs",
        "index.d.mts"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "coverage": "c8 --100 --reporter=text --reporter=json-summary npm test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0",
        "test": "node --test --test-reporter=@voxpelli/node-test-pretty-reporter",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "charwise": "^3.0.1",
        "chokidar": "^5.0.0",
        "classic-level": "^3.0.0",
        "p-queue": "^9.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "@voxpelli/node-test-pretty-reporter": "^1.1.2",
        "badge-maker": "^6.0.0",
        "c8": "^12.0.0",
        "eslint": "^10.8.0",
        "eslint-plugin-perfectionist": "^5.10.0",
        "globals": "^17.7.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2"
    }
}
